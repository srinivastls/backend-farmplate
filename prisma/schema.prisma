generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  name        String
  email       String   @unique
  password    String?
  firebaseUid String?  @unique
  role        UserRole @default(CUSTOMER)

  // Profile
  phone String?
  image String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  cart          Cart?
  farmer        Farmer?
  favorites     Favorite[]
  impact        Impact?
  notifications Notification[]
  orders        Order[]
  subscriptions Subscription[]
}

model Farmer {
  id        String   @id @default(cuid())
  userId    String   @unique
  farmName  String
  about     String?
  rating    Float    @default(5)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  farms     Farm[]
  user      User     @relation(fields: [userId], references: [id])
}

model Farm {
  id             String         @id @default(cuid())
  farmerId       String
  name           String
  description    String?
  latitude       Float
  longitude      Float
  address        String
  image          String?
  createdAt      DateTime       @default(now())
  farmer         Farmer         @relation(fields: [farmerId], references: [id])
  products       Product[]
  subscriptions  Subscription[]
  harvestBatches HarvestBatch[]
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  actionUrl String?
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  icon     String?
  products Product[]
}

model Product {
  id         String @id @default(cuid())
  farmId     String
  categoryId String

  name        String
  description String?
  image       String?

  organic Boolean @default(false)

  price Float // Price per unit (kg/litre/piece)

  quantity Float // Total available stock

  unit String // kg, litre, piece

  packSize Float @default(1)

  minOrderQty Float @default(1)

  marketPrice Float @default(0)

  harvestTime DateTime

  lotId String @unique

  createdAt DateTime @default(now())

  cartItems  CartItem[]
  favorites  Favorite[]
  orderItems OrderItem[]

  category Category @relation(fields: [categoryId], references: [id])
  farm     Farm     @relation(fields: [farmId], references: [id])

  traceEvents TraceEvent[]

  cropId String?
  crop   Crop?   @relation(fields: [cropId], references: [id])

  processingStage ProcessingStage @default(PROCESSED)

  qualityGrade String?

  co2Saved Float?

  waterSaved Float?

  shelfLife Int?

  harvestBatches HarvestBatch[]
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  latitude     Float
  longitude    Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   String
  productName String
  unit        String
  price       Float
  quantity    Float
  createdAt   DateTime @default(now())
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id String @id @default(cuid())

  orderId String?

  order Order? @relation(fields: [orderId], references: [id])

  razorpayOrderId String? @unique

  razorpayPaymentId String? @unique

  razorpaySignature String?

  amount Float

  currency String @default("INR")

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Order {
  id     String  @id @default(cuid())
  userId String?

  status        OrderStatus
  paymentStatus PaymentStatus

  subtotal    Float
  deliveryFee Float
  platformFee Float
  total       Float

  customerName String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?

  deliveryTime DateTime?
  createdAt    DateTime  @default(now())

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  unit        String
  price       Float
  quantity    Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model Crop {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProcessingStage {
  RAW
  SEMI_PROCESSED
  PROCESSED
  BY_PRODUCT
}

model TraceEvent {
  id          String         @id @default(cuid())
  productId   String
  title       String
  description String?
  latitude    Float?
  longitude   Float?
  temperature Float?
  image       String?
  createdAt   DateTime       @default(now())
  eventType   TraceEventType
  handledBy   String?
  humidity    Float?
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Impact {
  id               String   @id @default(cuid())
  userId           String   @unique
  co2Saved         Float    @default(0)
  foodMilesSaved   Float    @default(0)
  waterSaved       Float    @default(0)
  farmersSupported Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  type   NotificationType
  isRead Boolean          @default(false)

  createdAt DateTime @default(now())
}

enum NotificationType {
  ORDER
  PAYMENT
  OFFER
  SYSTEM
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  farmId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, farmId])
}

model HarvestBatch {
  id String @id @default(cuid())

  batchNumber String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])

  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id])

  quantity Float

  availableQuantity Float

  harvestDate DateTime

  qualityGrade String

  moisture Float?

  warehouse String?

  status BatchStatus

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum BatchStatus {
  HARVESTED

  PROCESSING

  PACKAGED

  IN_WAREHOUSE

  DISPATCHED

  COMPLETED
}

enum UserRole {
  CUSTOMER
  FARMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TraceEventType {
  SOWING
  FERTILIZER
  IRRIGATION
  HARVESTED
  QUALITY_CHECK
  HUB_RECEIVED
  OUT_FOR_DELIVERY
  DELIVERED
}
